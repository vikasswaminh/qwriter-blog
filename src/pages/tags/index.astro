---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, readingTime } from '../../utils/posts';

const posts = await getPublishedPosts();
const tagsMap = new Map();

for (const p of posts) {
  for (const t of p.data.tags) {
    if (!tagsMap.has(t)) {
      tagsMap.set(t, []);
    }
    tagsMap.get(t).push(p);
  }
}

// Sort tags alphabetically
const sortedTags = [...tagsMap.keys()].sort();
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <div class="tags-page-container">
    <div class="tags-header">
      <h1 class="tags-title">Explore <span class="text-gradient">Topics</span></h1>
      <p class="tags-subtitle">Browse our collection of guides, insights, and resources by category.</p>
    </div>

    {sortedTags.length === 0 && <p class="empty">No topics found.</p>}
    
    <div class="tags-content">
      {sortedTags.map(tag => (
        <section class="tag-section">
          <div class="tag-section-header">
            <h2 class="tag-section-title">{tag}</h2>
            <span class="tag-count-badge">{tagsMap.get(tag).length} {tagsMap.get(tag).length === 1 ? 'Article' : 'Articles'}</span>
          </div>
          <div class="post-list">
            {tagsMap.get(tag).map((p) => (
              <PostCard
                url={`/blog/${p.slug}/`}
                title={p.data.title}
                description={p.data.description}
                pubDate={p.data.pubDate}
                tags={p.data.tags}
                minutes={readingTime(p.body)}
              />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tags-page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .tags-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .tags-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--ink-black);
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }
  .text-gradient {
    background: linear-gradient(135deg, #f472b6, #a81c85);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .tags-subtitle {
    font-size: 1.1rem;
    color: var(--ink-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .tags-content {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-bottom: 5rem;
  }
  
  .tag-section-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid rgba(244, 114, 182, 0.2);
  }
  
  .tag-section-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--ink-black);
    margin: 0;
  }
  
  .tag-count-badge {
    font-size: 0.8rem;
    font-weight: 700;
    color: #a81c85;
    background: var(--candy-pink-soft);
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
  }
  
  .post-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }
  
  @media (max-width: 768px) {
    .tags-page-container { padding: 3rem 1.5rem; }
    .tags-title { font-size: 2.75rem; }
    .post-list { grid-template-columns: 1fr; }
  }
</style>
