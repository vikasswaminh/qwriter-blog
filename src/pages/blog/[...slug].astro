---
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

function getTagColor(tag: string) {
  const t = tag.toLowerCase();
  if (t === 'ai workforce') return '#ff8000';
  if (t === 'guide' || t === 'guides') return '#E3256B';
  const hash = tag.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const colors = ['#7C3AED', '#2563EB', '#0284C7', '#059669', '#D97706', '#0891B2', '#4F46E5', '#0D9488', '#F59E0B', '#E11D48'];
  return colors[hash % colors.length];
}

const tagColor = post.data.tags && post.data.tags.length > 0 ? getTagColor(post.data.tags[0]) : 'var(--accent)';
---

<PostLayout post={post} headings={headings}>
  <div style={`--accent: ${tagColor}; --candy-pink: ${tagColor}; --candy-pink-hover: ${tagColor}; --color-primary: ${tagColor}; --color-primary-hover: ${tagColor};`}>
    <Content />
  </div>
</PostLayout>
