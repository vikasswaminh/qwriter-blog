---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../config';
import { getPublishedPosts, readingTime } from '../utils/posts';

const posts = await getPublishedPosts();
const featured = posts[0];
const rest = posts.slice(1);
---

<BaseLayout>
  <div class="home-layout">
    <aside class="sidebar-left">
      <span class="sidebar-title">STRATEGY & PLATFORM</span>
      <ul class="sidebar-list">
        <li><a href="/blog/what-is-an-ai-workforce">What Is an AI Workforce? How AI Teams Are Changing Work — The Complete 2026 Guide</a></li>
        <li><a href="/blog/ai-agents-vs-ai-assistants-whats-the-difference">AI Agents vs AI Assistants: What's the Difference?</a></li>
        <li><a href="/blog/what-are-ai-agents-complete-guide-for-businesses-2026">What Are AI Agents? A Complete Guide for Businesses (2026)</a></li>
        <li><a href="/blog" style="color: var(--accent); font-weight: 600;">View All →</a></li>
      </ul>
    </aside>

    <main class="main-content">
      <section class="hero">
        <h1 class="hero-title">{SITE.brand} <span style="color: var(--accent);">Blog</span></h1>
        <p class="hero-tagline">{SITE.description}</p>
      </section>

      <div class="section-header">
        <span class="section-badge">NEWEST ARTICLES</span>
        <span class="section-desc">Latest from our experts</span>
      </div>

      {posts.length === 0 && <p class="empty">No posts yet — check back soon.</p>}

      {
        featured && (
          <a class="featured" href={`/blog/${featured.slug}/`}>
            <div class="featured-media">
              {featured.data.cover ? (
                <img src={featured.data.cover} alt={featured.data.title} class="featured-img" width="1200" height="630" loading="eager" decoding="async" />
              ) : (
                <div class="featured-img-placeholder"></div>
              )}
            </div>
            <div class="featured-content">
              {featured.data.tags && featured.data.tags.length > 0 && (
                <span class="featured-tag">{featured.data.tags[0]}</span>
              )}
              <h2 class="featured-title">{featured.data.title}</h2>
              <div class="featured-meta">
                <span>{readingTime(featured.body)} min read</span>
                <span aria-hidden="true">·</span>
                <span class="featured-more">Read article →</span>
              </div>
            </div>
          </a>
        )
      }

      {
        rest.length > 0 && (
          <div class="post-list">
            {rest.map((p) => (
              <PostCard
                url={`/blog/${p.slug}/`}
                title={p.data.title}
                description={p.data.description}
                pubDate={p.data.pubDate}
                tags={p.data.tags}
                minutes={readingTime(p.body)}
              />
            ))}
          </div>
        )
      }
    </main>

    <aside class="sidebar-right">
      <span class="sidebar-title purple">AUTOMATION & TOOLS</span>
      <ul class="sidebar-list">
        <li><a href="/blog/best-ai-tools-for-business-2026">Best AI Tools for Business in 2026: The Complete, No-Fluff Buyer's Guide</a></li>
        <li><a href="/blog/ai-automation-how-businesses-can-automate-workflows-with-ai">AI Automation: How Businesses Can Automate Workflows With AI</a></li>
        <li><a href="/blog" style="color: #3b82f6; font-weight: 600;">View All Guides →</a></li>
      </ul>
    </aside>
  </div>
</BaseLayout>
