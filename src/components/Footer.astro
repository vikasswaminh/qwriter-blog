<style>
  .os-site-footer {
    background-color: var(--warm-cream);
    border-top: 1px solid var(--border-medium);
    padding: 64px 0 32px;
    margin-top: 80px;
  }
  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 32px;
    margin-bottom: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: 16px;
  }
  .brand-desc {
    color: var(--ink-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 280px;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
  }
  .soc-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-muted);
    border: 1px solid var(--border-medium);
    padding: 4px 8px;
    border-radius: 4px;
  }
  .footer-heading {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-black);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
  }
  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-list li {
    margin-bottom: 12px;
  }
  .footer-list a {
    color: var(--ink-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }
  .footer-list a:hover {
    color: var(--candy-pink);
  }
  .footer-bottom {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-light);
    padding-top: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .copyright {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .legal-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .legal-links a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }
  .legal-links a:hover {
    color: var(--ink-black);
  }
  
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  
  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-brand-col {
      grid-column: span 1;
    }
  }
</style>
